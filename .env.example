# Copy to .env (git-ignored). Values match the local cluster from `make dev-up`.
# Read by scripts/upload_card.py (shell variables take precedence). Future
# app/backend code should read these rather than hardcoding endpoints.
# With S3_ENDPOINT set, scripts target the local stand-in; unset it for AWS S3.

# S3-compatible storage (local moto stand-in; credentials are not checked). Path-style addressing.
S3_ENDPOINT=http://sleeved-storage.localhost:8080
S3_BUCKET=sleeved-collection
AWS_ACCESS_KEY_ID=dev
AWS_SECRET_ACCESS_KEY=dev
AWS_DEFAULT_REGION=us-east-1

# Postgres (local, via the port-forward from `make dev-db`).
DATABASE_URL=postgres://sleeved:sleeved-dev@localhost:5432/sleeved

# OAuth (planned). Create your own dev apps; never commit real values.
# Redirect URI for local dev: http://localhost:5173/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
